rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "cmedapp@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN")
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.role in ['ADMIN', 'FORMATEUR', 'BÉNÉFICIAIRE'];
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(request.resource.data) && (
        (request.auth.uid == userId && (request.resource.data.role == 'BÉNÉFICIAIRE' || isAdmin())) ||
        isAdmin()
      );
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(request.resource.data) && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
